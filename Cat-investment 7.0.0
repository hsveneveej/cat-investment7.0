<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Divisor de Vídeo</title>
<style>
  :root{
    --bg: #0d0f12;
    --panel: #16191d;
    --line: #262a30;
    --text: #e8e6e1;
    --muted: #8b9099;
    --accent: #ff5a36;
    --accent-dim: #7a2c1c;
    --mono: 'SF Mono', 'Roboto Mono', monospace;
  }
  * { box-sizing: border-box; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system, system-ui, 'Segoe UI', sans-serif;
    padding: 20px 16px 60px;
    min-height:100vh;
  }
  .eyebrow{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.15em;
    text-transform:uppercase;
    color:var(--accent);
    margin:0 0 6px;
  }
  h1{ font-size:22px; margin:0 0 4px; letter-spacing:-0.01em; }
  .sub{ color:var(--muted); font-size:13px; margin:0 0 24px; line-height:1.5; }
  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    padding:18px;
    margin-bottom:16px;
  }
  label{ display:block; font-size:12px; color:var(--muted); margin-bottom:8px; }
  input[type="file"]{ width:100%; color:var(--text); font-size:13px; }
  .row{ display:flex; gap:10px; margin-top:16px; }
  .field{ flex:1; }
  input[type="number"]{
    width:100%; background:#0d0f12; border:1px solid var(--line);
    color:var(--text); padding:10px; border-radius:8px; font-size:15px;
  }
  .modes{ display:flex; gap:8px; margin-top:8px; }
  .mode-btn{
    flex:1; background:#0d0f12; border:1px solid var(--line); color:var(--muted);
    padding:10px 8px; border-radius:8px; font-size:12px; text-align:center;
  }
  .mode-btn.active{
    border-color:var(--accent); color:var(--text); background:rgba(255,90,54,0.08);
  }
  .dest-btn{
    width:100%; margin-top:10px; padding:10px; border:1px dashed var(--line);
    border-radius:8px; background:transparent; color:var(--muted); font-size:12px;
  }
  .dest-btn.set{ border-color:var(--accent); color:var(--text); border-style:solid; }
  button#splitBtn{
    width:100%; margin-top:18px; padding:14px; border:none; border-radius:10px;
    background:var(--accent); color:#100603; font-weight:700; font-size:15px; letter-spacing:.02em;
  }
  button#splitBtn:disabled{ background:var(--accent-dim); color:#a86a5c; }
  #status{
    font-family:var(--mono); font-size:12px; color:var(--muted);
    margin-top:12px; min-height:16px; white-space:pre-wrap;
  }
  #progressWrap{
    height:6px; background:var(--line); border-radius:3px;
    margin-top:10px; overflow:hidden; display:none; position:relative;
  }
  #progressBar{
    height:100%; width:30%; background:var(--accent); border-radius:3px;
    position:absolute; left:-30%;
    animation: indet 1.1s ease-in-out infinite;
  }
  #progressBar.determinate{ animation:none; left:0; width:0%; transition:width .2s; }
  @keyframes indet{
    0% { left:-30%; }
    50% { left:60%; }
    100% { left:-30%; }
  }
  #results{ display:flex; flex-direction:column; gap:12px; }
  .clip{ background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px; }
  .clip-header{
    display:flex; justify-content:space-between; align-items:center;
    margin-bottom:8px; font-family:var(--mono); font-size:12px; color:var(--muted);
  }
  video{ width:100%; border-radius:8px; display:block; background:#000; }
  .clip a{
    display:block; text-align:center; margin-top:8px; padding:9px;
    border:1px solid var(--line); border-radius:8px; color:var(--text); text-decoration:none; font-size:13px;
  }
  .clip a:active{ border-color:var(--accent); }
  #resultsTitle{
    font-family:var(--mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase;
    color:var(--muted); margin: 24px 0 12px; display:flex; justify-content:space-between; align-items:center;
  }
  #zipBtn{
    background:var(--panel); border:1px solid var(--accent); color:var(--text);
    padding:8px 12px; border-radius:8px; font-size:11px; font-family:var(--mono);
  }
</style>
</head>
<body>

  <p class="eyebrow">Ferramenta local — roda no seu celular</p>
  <h1>Divisor de vídeo</h1>
  <p class="sub">Corta um vídeo em partes de duração fixa direto no navegador. Nada é enviado pra internet — o processamento acontece no seu aparelho.</p>

  <div class="card">
    <label>Escolher vídeo</label>
    <input type="file" id="fileInput" accept="video/*">

    <div class="row">
      <div class="field">
        <label>Duração de cada parte (segundos)</label>
        <input type="number" id="duration" value="10" min="1" max="120">
      </div>
    </div>

    <label style="margin-top:16px;">Modo de corte</label>
    <div class="modes">
      <div class="mode-btn active" data-mode="fast" id="modeFast">Rápido<br><span style="font-size:10px;">(duração aproximada)</span></div>
      <div class="mode-btn" data-mode="exact" id="modeExact">Exato<br><span style="font-size:10px;">(mais lento)</span></div>
    </div>

    <button class="dest-btn" id="destBtn">📁 Escolher pasta de destino (só disponível no Chrome de computador)</button>

    <button id="splitBtn">Dividir vídeo</button>
    <div id="progressWrap"><div id="progressBar"></div></div>
    <div id="status"></div>
  </div>

  <div id="resultsTitle" style="display:none;">
    <span>Partes geradas</span>
    <button id="zipBtn">Baixar tudo (.zip)</button>
  </div>
  <div id="results"></div>

<script src="https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js"></script>
<script src="https://unpkg.com/jszip@3.10.1/dist/jszip.min.js"></script>
<script>
  const { createFFmpeg, fetchFile } = FFmpeg;
  // corePath fixo na versão single-thread: não exige SharedArrayBuffer/COOP/COEP,
  // então funciona abrindo o arquivo direto no navegador (file:// ou CDN simples).
  const ffmpeg = createFFmpeg({
    log: true,
    corePath: 'https://unpkg.com/@ffmpeg/core@0.11.0/dist/ffmpeg-core.js'
  });

  let mode = 'fast';
  let dirHandle = null;
  let lastLog = '';
  let generatedFiles = []; // { name, blob }

  document.getElementById('modeFast').onclick = () => setMode('fast');
  document.getElementById('modeExact').onclick = () => setMode('exact');
  function setMode(m){
    mode = m;
    document.getElementById('modeFast').classList.toggle('active', m === 'fast');
    document.getElementById('modeExact').classList.toggle('active', m === 'exact');
  }

  // Folder picker: only works on secure context (https/localhost) + supporting browsers (desktop Chrome/Edge).
  // Won't be available on file:// or on Android Chrome — button hides itself if unsupported.
  const destBtn = document.getElementById('destBtn');
  if (!window.showDirectoryPicker || location.protocol === 'file:') {
    destBtn.style.display = 'none';
  } else {
    destBtn.onclick = async () => {
      try {
        dirHandle = await window.showDirectoryPicker();
        destBtn.textContent = '📁 Pasta selecionada ✓';
        destBtn.classList.add('set');
      } catch (e) { /* user cancelled */ }
    };
  }

  ffmpeg.setLogger(({ message }) => { lastLog = message; });

  const statusEl = document.getElementById('status');
  const resultsEl = document.getElementById('results');
  const resultsTitle = document.getElementById('resultsTitle');
  const splitBtn = document.getElementById('splitBtn');
  const progressWrap = document.getElementById('progressWrap');
  const progressBar = document.getElementById('progressBar');
  const zipBtn = document.getElementById('zipBtn');

  let timerStart = 0;
  let timerHandle = null;
  function startTimer(label){
    timerStart = Date.now();
    clearInterval(timerHandle);
    timerHandle = setInterval(() => {
      const s = ((Date.now() - timerStart) / 1000).toFixed(1);
      statusEl.textContent = `${label} (${s}s)`;
    }, 150);
  }
  function stopTimer(){ clearInterval(timerHandle); }

  splitBtn.onclick = async () => {
    const fileInput = document.getElementById('fileInput');
    const duration = document.getElementById('duration').value || 10;

    if (!fileInput.files.length) {
      statusEl.textContent = 'Escolha um vídeo primeiro.';
      return;
    }

    const file = fileInput.files[0];
    splitBtn.disabled = true;
    resultsEl.innerHTML = '';
    generatedFiles = [];
    resultsTitle.style.display = 'none';
    progressWrap.style.display = 'block';
    progressBar.classList.remove('determinate');

    try {
      if (!ffmpeg.isLoaded()) {
        startTimer('Carregando motor de vídeo — só na primeira vez, precisa de internet');
        await ffmpeg.load();
        stopTimer();
      }

      startTimer('Lendo o arquivo de vídeo');
      ffmpeg.FS('writeFile', 'input.mp4', await fetchFile(file));
      stopTimer();

      startTimer(mode === 'fast' ? 'Dividindo (modo rápido)' : 'Dividindo com duração exata — pode demorar');

      // Build args cleanly (no unsafe splicing) to avoid corrupting -map/-c order.
      let args = ['-i', 'input.mp4', '-map', '0'];
      if (mode === 'fast') {
        args.push('-c', 'copy');
      } else {
        args.push(
          '-c:v', 'libx264', '-c:a', 'aac',
          '-force_key_frames', `expr:gte(t,n_forced*${duration})`
        );
      }
      args.push(
        '-segment_time', String(duration),
        '-f', 'segment',
        '-reset_timestamps', '1',
        'output%03d.mp4'
      );

      await ffmpeg.run(...args);
      stopTimer();

      statusEl.textContent = 'Gerando prévias...';
      const files = ffmpeg.FS('readdir', '.').filter(f => f.startsWith('output'));

      if (files.length === 0) {
        statusEl.textContent = 'Não consegui gerar partes.\nÚltima mensagem do FFmpeg:\n' + (lastLog || '(sem detalhes)') + '\n\nTente o modo "Exato" — alguns formatos de vídeo não suportam o modo rápido.';
      } else {
        for (let i = 0; i < files.length; i++) {
          const name = files[i];
          const data = ffmpeg.FS('readFile', name);
          const blob = new Blob([data.buffer], { type: 'video/mp4' });
          const outName = `parte_${String(i + 1).padStart(2, '0')}.mp4`;
          generatedFiles.push({ name: outName, blob });

          if (dirHandle) {
            try {
              const fh = await dirHandle.getFileHandle(outName, { create: true });
              const writable = await fh.createWritable();
              await writable.write(blob);
              await writable.close();
            } catch (e) { console.error('Erro salvando na pasta:', e); }
          }

          const url = URL.createObjectURL(blob);
          const container = document.createElement('div');
          container.className = 'clip';

          const header = document.createElement('div');
          header.className = 'clip-header';
          header.innerHTML = `<span>Parte ${i + 1}</span><span>${(blob.size / (1024*1024)).toFixed(1)} MB</span>`;

          const video = document.createElement('video');
          video.src = url;
          video.controls = true;
          video.playsInline = true;

          const link = document.createElement('a');
          link.href = url;
          link.download = outName;
          link.textContent = dirHandle ? `Salvo na pasta ✓ (baixar também)` : `Baixar parte ${i + 1}`;

          container.appendChild(header);
          container.appendChild(video);
          container.appendChild(link);
          resultsEl.appendChild(container);

          ffmpeg.FS('unlink', name);
        }

        resultsTitle.style.display = 'flex';
        statusEl.textContent = `Pronto — ${files.length} partes geradas${dirHandle ? ' e salvas na pasta escolhida' : ''}.`;
      }

      ffmpeg.FS('unlink', 'input.mp4');
    } catch (err) {
      stopTimer();
      console.error(err);
      statusEl.textContent = 'Erro: ' + (err.message || 'algo deu errado') + '\nÚltima mensagem do FFmpeg:\n' + (lastLog || '(sem detalhes)');
    } finally {
      splitBtn.disabled = false;
      progressWrap.style.display = 'none';
    }
  };

  zipBtn.onclick = async () => {
    zipBtn.textContent = 'Compactando...';
    const zip = new JSZip();
    generatedFiles.forEach(f => zip.file(f.name, f.blob));
    const content = await zip.generateAsync({ type: 'blob' });
    const url = URL.createObjectURL(content);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'partes_video.zip';
    document.body.appendChild(a);
    a.click();
    a.remove();
    zipBtn.textContent = 'Baixar tudo (.zip)';
  };
</script>
</body>
</html>
